#!/bin/bash
# ocs-pbs-bare-metal-restore - fully automated PBS bare-metal restore.
#
# Launched directly at boot (via the "Proxmox Backup Client Go - PBS Bare
# Metal Restore" GRUB/isolinux menu entry's ocs_live_run= boot parameter),
# BEFORE Clonezilla's own interactive language/keyboard prompts or main menu
# ever appear (those are also skipped via that same menu entry's
# locales=/keyboard-layouts= boot params). Walks straight through: network
# up, PBS server/credentials, pick a snapshot, attach it via NBD, auto-detect
# the target disk, double-confirm, then invoke ocs-onthefly directly with a
# precomputed command line -- Clonezilla's own generic
# device-image/device-device/beginner-mode wizard tree is never shown at
# all, unlike the manual "pbs-nbd" menu entry (ocs-pbs-nbd), which still
# hands off to that generic wizard afterward.
#
# Deliberately NOT sharing code with ocs-pbs-nbd (some duplication of the
# network/credentials/snapshot-picker/NBD-attach steps below): that script
# is proven reliable after a long live debugging session tonight
# (2026-09-24) and must not be touched/risked while THIS script is still
# getting its own first real test. Worth consolidating into shared functions
# later, once this path has its own track record.
#
# Usage: ocs-pbs-bare-metal-restore [NBD_NUMBER]    (default: 0 -> /dev/nbd0)

DRBL_SCRIPT_PATH="${DRBL_SCRIPT_PATH:-/usr/share/drbl}"
. $DRBL_SCRIPT_PATH/sbin/drbl-conf-functions
. /etc/drbl/drbl-ocs.conf
. $DRBL_SCRIPT_PATH/sbin/ocs-functions
[ -e "/etc/ocs/ocs-live.conf" ] && . /etc/ocs/ocs-live.conf

check_if_root
check_if_in_clonezilla_live
ask_and_load_lang_set
mkdir -p $ocs_log_dir
check_DIA_set_ESC $DIA

PBSNBD="/usr/local/sbin/pbsnbd"
NBDNUM="${1:-0}"
NBDDEV="/dev/nbd${NBDNUM}"
DIA_TMP="$(mktemp /tmp/pbsbmr-dia.XXXXXX)"
LIST_TMP="$(mktemp /tmp/pbsbmr-list.XXXXXX)"
LIST_ERR="$(mktemp /tmp/pbsbmr-err.XXXXXX)"
ATTACH_LOG="/tmp/pbsbmr-attach-$$.log"
trap "rm -f \"$DIA_TMP\" \"$LIST_TMP\" \"$LIST_ERR\"" HUP INT QUIT TERM EXIT

path_without_comment() { printf '%s' "${1%%\#*}"; }
comment_of_line() {
  case "$1" in
    *#*) printf '%s' "${1##*\#}" ;;
    *)   printf '' ;;
  esac
}

CRED_FILE="/tmp/pbsnbd-credentials"
save_credentials() {
  {
    echo "server|$PBS_SERVER"
    echo "username|$PBS_USER"
    echo "password|$PBS_PASS"
    echo "datastore|$PBS_DS_NS"
  } > "$CRED_FILE"
  chmod 600 "$CRED_FILE"
}
load_credentials() {
  SAVED_SERVER=""; SAVED_USER=""; SAVED_PASS=""; SAVED_DSNS=""
  [ -f "$CRED_FILE" ] || return 0
  while IFS='|' read -r key value; do
    [ -n "$key" ] || continue
    case "$key" in
      server)   SAVED_SERVER="$value" ;;
      username) SAVED_USER="$value" ;;
      password) SAVED_PASS="$value" ;;
      datastore) SAVED_DSNS="$value" ;;
    esac
  done < "$CRED_FILE"
  return 0
}

echo "=== PBS Bare Metal Restore (fully automated) ==="

load_credentials

# 1. network up. Auto-attempt DHCP on every detected NIC FIRST, silently --
# network_config_if_necessary (below) only runs Clonezilla's own interactive
# ocs-live-netcfg wizard (which is where BOTH the "DHCP or static?" choice
# AND its own internal time-sync prompt live) when it finds NO IP already
# configured, so a successful pre-emptive DHCP here skips that whole
# interactive wizard entirely -- this is the zero-prompt path for the
# common case (a real network with DHCP). If DHCP genuinely isn't
# available, network_config_if_necessary still falls back to the
# interactive wizard as a safety net, same as it always did.
for nic in /sys/class/net/*; do
  dev="$(basename "$nic")"
  [ "$dev" = "lo" ] && continue
  echo "> Attempting DHCP on ${dev}..."
  dhcpcd -t 15 "$dev" >/dev/null 2>&1
done
network_config_if_necessary

# Sync time via NTP automatically, no prompt either way: -b (batch, never
# asks anything, including the interactive timezone/RTC fallback this
# script has for a no-internet case -- that fallback is deliberately
# skipped, not just silenced, since it needs a human's timezone answer) and
# -i (internet-based sync only). Touches /run/live/ocs-live-time-sync on
# success, which ALSO makes ocs-live-netcfg's own internal time-sync prompt
# (see above) correctly skip itself if the interactive network fallback
# above ever runs after this succeeds.
ocs-live-time-sync -b -i >/dev/null 2>&1 || true

# 2. stop a previous pbsnbd instance so this run starts from a clean slate
PIDS=""
pgrep -x pbsnbd >/dev/null 2>&1 && PIDS="$(pgrep -x pbsnbd | tr '\n' ' ')"
if [ -n "$PIDS" ]; then
  echo "Stopping previous pbsnbd instance(s) (PID: ${PIDS})..."
  pkill -INT -x pbsnbd 2>/dev/null || true
  i=0
  while pgrep -x pbsnbd >/dev/null 2>&1 && [ $i -lt 8 ]; do sleep 1; i=$((i+1)); done
  pgrep -x pbsnbd >/dev/null 2>&1 && pkill -KILL -x pbsnbd 2>/dev/null || true
fi

# 3. load the NBD kernel module
if ! modprobe nbd max_part=0; then
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --msgbox "Unable to 'modprobe nbd max_part=0'!\n\n$msg_program_stop" 0 0 $DIA_ESC
  exit 1
fi
sleep 1

# 4. PBS connection details -- one combined form (server URL, username,
# password, datastore) instead of 4 separate screens, matching Mick's
# explicit ask 2026-09-24 after the first real timed runs. Validates all
# 4 fields locally, then actually tests the connection (the -list call
# itself -- no separate round-trip, since we need that data next anyway)
# BEFORE moving on. Any validation or connection failure loops back to
# this SAME form, pre-filled with whatever was entered, rather than
# exiting outright.
PBS_SERVER="${SAVED_SERVER:-https://}"
PBS_USER="${SAVED_USER:-root@pam}"
PBS_PASS="${SAVED_PASS}"
PBS_DS_NS="${SAVED_DSNS}"

while true; do
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --mixedform "Enter PBS connection details:" 17 70 4 \
    "Server URL:" 1 1 "$PBS_SERVER" 1 14 50 0 0 \
    "Username:"   3 1 "$PBS_USER"   3 14 50 0 0 \
    "Password:"   5 1 "$PBS_PASS"   5 14 50 0 1 \
    "Datastore:"  7 1 "$PBS_DS_NS"  7 14 50 0 0 \
  2> "$DIA_TMP"
  if [ "$?" != "0" ]; then
    echo "$msg_program_stop!"
    exit 1
  fi
  PBS_SERVER="$(sed -n '1p' "$DIA_TMP")"
  PBS_USER="$(sed -n '2p' "$DIA_TMP")"
  PBS_PASS="$(sed -n '3p' "$DIA_TMP")"
  PBS_DS_NS="$(sed -n '4p' "$DIA_TMP")"

  ERR=""
  case "$PBS_SERVER" in
    https://*) [ "$PBS_SERVER" = "https://" ] && ERR="Server URL must be complete, e.g. https://pbs.example.com:8007" ;;
    *) ERR="Server URL must start with https://" ;;
  esac
  if [ -z "$ERR" ]; then
    case "$PBS_USER" in
      *@*) ;;
      *) ERR="Username must include a realm, e.g. 'user@pam' or 'user@pbs'." ;;
    esac
  fi
  [ -z "$ERR" ] && [ -z "$PBS_PASS" ] && ERR="Password must not be empty."
  if [ -z "$ERR" ]; then
    case "$PBS_DS_NS" in
      '') ERR="Datastore must not be empty." ;;
      /*) ERR="Datastore must not start with '/'." ;;
    esac
  fi
  if [ -n "$ERR" ]; then
    $DIA --backtitle "$msg_nchc_free_software_labs" --title "$msg_nchc_clonezilla" \
    --msgbox "$ERR" 0 0 $DIA_ESC
    continue
  fi

  PBS_DS="${PBS_DS_NS%%/*}"
  if [ "$PBS_DS_NS" != "${PBS_DS_NS#*/}" ]; then
    PBS_NS="${PBS_DS_NS#*/}"
  else
    PBS_NS=""
  fi
  NS_OPT=""
  [ -n "$PBS_NS" ] && NS_OPT="-namespace $PBS_NS"

  echo "> Testing connection to ${PBS_SERVER} (datastore=${PBS_DS}${PBS_NS:+, namespace=${PBS_NS}})..."
  if "$PBSNBD" -baseurl "$PBS_SERVER" -username "$PBS_USER" -password "$PBS_PASS" \
       -datastore "$PBS_DS" $NS_OPT -list > "$LIST_TMP" 2> "$LIST_ERR"; then
    if [ -s "$LIST_TMP" ]; then
      break
    fi
    $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
    --msgbox "Connected, but no backups found in datastore '${PBS_DS}'${PBS_NS:+ (namespace '${PBS_NS}')}.\n\nCheck the details and try again." 0 0 $DIA_ESC
  else
    $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
    --msgbox "Connection test failed:\n$(cat "$LIST_ERR")\n\nCheck the details and try again." 0 0 $DIA_ESC
  fi
done
echo "PBS server URL  : $PBS_SERVER"
echo "PBS username    : $PBS_USER"
echo "PBS password    : (entered)"
echo "PBS datastore   : ${PBS_DS}"
echo "PBS namespace   : ${PBS_NS:-<none>}"

save_credentials

# 5. three-level selection: (a) <kind>/<backupid>, (b) date, (c) .fidx file
declare -A KDT
declare -a KDT_ORDER
while IFS= read -r line; do
  [ -n "$line" ] || continue
  r2="${line#*/}"; r3="${r2#*/}"
  kdt="${line%%/*}/${r2%%/*}|${r3%%/*}"
  if [ -z "${KDT[$kdt]+x}" ]; then
    KDT[$kdt]=1
    KDT_ORDER+=("$kdt")
  else
    KDT[$kdt]=$((KDT[$kdt]+1))
  fi
done < "$LIST_TMP"

declare -a KEYS
declare -A KEY_N
n=0
for kdt in "${KDT_ORDER[@]}"; do
  key="${kdt%%|*}"
  if [ -z "${KEY_N[$key]+x}" ]; then
    KEY_N[$key]=$((n+1))
    KEYS+=("$key")
    n=$((n+1))
  fi
done
if [ "$n" -gt 1 ]; then
  declare -a MENU1
  i=1
  for key in "${KEYS[@]}"; do
    comment=""
    while IFS= read -r line; do
      r2="${line#*/}"
      [ "${line%%/*}/${r2%%/*}" = "$key" ] || continue
      comment="$(comment_of_line "$line")"
      break
    done < "$LIST_TMP"
    label="$key"
    [ -n "$comment" ] && label="$key  ($comment)"
    MENU1+=("$i" "$label")
    i=$((i+1))
  done
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --menu "Select the VM / container / host to restore:" 0 0 15 \
  "${MENU1[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICE1="$(cat "$DIA_TMP")"
  if [ -z "$CHOICE1" ]; then
    echo "$msg_program_stop!"
    exit 1
  fi
  KEY="${KEYS[$((CHOICE1-1))]}"
else
  KEY="${KEYS[0]}"
fi
echo "Selected backup ID : $KEY"

declare -a MENU2
declare -a DATES2
i=1
for kdt in "${KDT_ORDER[@]}"; do
  [ "${kdt%%|*}" = "$KEY" ] || continue
  dt="${kdt#*|}"
  MENU2+=("$i" "$dt  (${KDT[$kdt]} file(s))")
  DATES2+=("$dt")
  i=$((i+1))
done
num2=$((i-1))
if [ "$num2" -gt 1 ]; then
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --menu "Backups of ${KEY} (select by date):" 0 0 15 \
  "${MENU2[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICE2="$(cat "$DIA_TMP")"
  if [ -z "$CHOICE2" ]; then
    echo "$msg_program_stop!"
    exit 1
  fi
  DT="${DATES2[$((CHOICE2-1))]}"
else
  DT="${DATES2[0]}"
fi
echo "Selected backup    : $KEY/$DT"

declare -a MENU3
declare -a LINES3
i=1
while IFS= read -r line; do
  [ -n "$line" ] || continue
  r2="${line#*/}"; f2="${r2%%/*}"; r3="${r2#*/}"; dt="${r3%%/*}"
  [ "${line%%/*}/${f2}" = "$KEY" ] || continue
  [ "$dt" = "$DT" ] || continue
  file="$(path_without_comment "${r3#*/}")"
  MENU3+=("$i" "$file")
  LINES3+=("$line")
  i=$((i+1))
done < "$LIST_TMP"
num3=$((i-1))
if [ "$num3" -gt 1 ]; then
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --menu "Select the disk image of ${KEY} (${DT}) to restore:" 0 0 15 \
  "${MENU3[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICE3="$(cat "$DIA_TMP")"
  if [ -z "$CHOICE3" ]; then
    echo "$msg_program_stop!"
    exit 1
  fi
  SELECTED="${LINES3[$((CHOICE3-1))]}"
else
  SELECTED="${LINES3[0]}"
fi
echo "Selected file      : $SELECTED"

# 6. attach in the foreground this time (we need it up before continuing,
# unlike ocs-pbs-nbd's fork-and-return-to-menu design) -- setsid so it
# survives this script's own exit once the restore is running.
echo "> Attaching '${SELECTED}' to ${NBDDEV}..."
setsid "$PBSNBD" -baseurl "$PBS_SERVER" -username "$PBS_USER" -password "$PBS_PASS" \
     -datastore "$PBS_DS" $NS_OPT -nbd "$NBDNUM" -path "$SELECTED" < /dev/null > "$ATTACH_LOG" 2>&1 &
PBSNBD_PID=$!

WAITED=0
while [ ! -b "$NBDDEV" ] && [ "$WAITED" -lt 20 ]; do
  sleep 0.5
  WAITED=$((WAITED + 1))
done
if [ ! -b "$NBDDEV" ]; then
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --msgbox "WARNING: ${NBDDEV} did not appear within 10s.\n\nLog: ${ATTACH_LOG}\n\n$msg_program_stop" 0 0 $DIA_ESC
  exit 1
fi
partprobe "$NBDDEV" >/dev/null 2>&1
partx -a "$NBDDEV" >/dev/null 2>&1
udevadm settle --timeout=10 >/dev/null 2>&1

# 7. auto-detect the target disk: the one non-NBD, non-removable, non-loop,
# non-optical local block device. Zero or more than one -> ask, never guess
# on an ambiguous multi-disk machine (this is an irreversible drive-wipe).
declare -a CANDIDATES
for bd in /sys/block/*; do
  name="$(basename "$bd")"
  case "$name" in
    nbd*|loop*|sr*|ram*) continue ;;
  esac
  [ -f "$bd/removable" ] && [ "$(cat "$bd/removable" 2>/dev/null)" = "1" ] && continue
  [ -b "/dev/$name" ] && CANDIDATES+=("/dev/$name")
done

if [ "${#CANDIDATES[@]}" -eq 0 ]; then
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --msgbox "No local target disk found (only removable/optical/loop devices detected).\n\n$msg_program_stop" 0 0 $DIA_ESC
  exit 1
elif [ "${#CANDIDATES[@]}" -eq 1 ]; then
  TARGET="${CANDIDATES[0]}"
else
  declare -a MENUT
  i=1
  for c in "${CANDIDATES[@]}"; do
    sz="$(LC_ALL=C parted -s "$c" unit GB print 2>/dev/null | grep -m1 '^Disk .*:' | sed -E 's/.*: *//')"
    MENUT+=("$i" "$c  (${sz:-unknown size})")
    i=$((i+1))
  done
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --menu "Multiple local disks found -- select the RESTORE TARGET (will be COMPLETELY OVERWRITTEN):" 0 0 15 \
  "${MENUT[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICET="$(cat "$DIA_TMP")"
  if [ -z "$CHOICET" ]; then
    echo "$msg_program_stop!"
    exit 1
  fi
  TARGET="${CANDIDATES[$((CHOICET-1))]}"
fi
echo "Target disk        : $TARGET"

SRC_SIZE="$(LC_ALL=C parted -s "$NBDDEV" unit GB print 2>/dev/null | grep -m1 '^Disk .*:' | sed -E 's/.*: *//')"
TGT_SIZE="$(LC_ALL=C parted -s "$TARGET" unit GB print 2>/dev/null | grep -m1 '^Disk .*:' | sed -E 's/.*: *//')"

# 8. confirmation before the destructive write: shows source+target+sizes.
# Deliberately just the one dialog here, not also a typed device-name
# step -- ocs-onthefly itself (below, no -batch) still asks its own two
# separate "y" confirmations before actually wiping the destination, so a
# third, slower, typed confirmation on top of that was redundant friction
# rather than real extra safety. Mick's call, 2026-09-24, after the first
# real timed run: this was the slowest manual step other than the
# mandatory PBS server details.
$DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore - CONFIRM" \
--yesno "Source (PBS snapshot) : ${NBDDEV}  (${SRC_SIZE:-unknown size})\nTarget (THIS MACHINE)  : ${TARGET}  (${TGT_SIZE:-unknown size})\n\nEVERYTHING on ${TARGET} will be PERMANENTLY OVERWRITTEN.\n\nContinue?" 0 0
if [ "$?" != "0" ]; then
  echo "$msg_program_stop!"
  exit 1
fi

# 10. run the restore directly -- skips Clonezilla's own generic
# device-image/device-device/beginner-mode wizard tree entirely.
#   -icds    ignore destination-disk-size check (target may not be an exact
#            size match, e.g. replacement hardware with a slightly larger disk)
#   -k0      use the partition table from the source image (default, explicit)
#   -sfsck   skip checking/repairing the source filesystem
# No -p (postaction) here deliberately: this is the zero-choice BMR flow, so
# the reboot itself is handled explicitly below with our own message,
# instead of ocs-onthefly's own generic "-p choose" prompt (which is right
# for the manual ocs-pbs-nbd path, where an operator is already driving
# Clonezilla's menus, but wrong here).
echo "> Starting restore: ${NBDDEV} -> ${TARGET} ..."
ocs-onthefly -icds -k0 -sfsck -f "$NBDDEV" -d "$TARGET"
RC=$?
if [ "$RC" != "0" ]; then
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --msgbox "Restore finished with a non-zero exit code ($RC).\nCheck ${ocs_log_dir} for details.\n\n$msg_press_enter_to_continue" 0 0 $DIA_ESC
else
  $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
  --msgbox "Restore is complete. The system will now reboot and you will be prompted when to remove the temporary boot drive." 0 0 $DIA_ESC
  reboot
fi

exit "$RC"
