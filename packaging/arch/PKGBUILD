# Maintainer: Salvanza contributors
#
# salvanza, the same layout as the .deb and .rpm
# (packaging/debian/README.md):
#   /usr/bin/salvanza-cli          the command line: backup-folder, backup-disk,
#                                  attach-nbd (root)
#   /usr/bin/proxmoxbackup-{directory,machine,nbd}  its earlier names (links)
#   /usr/bin/salvanza-gui          the app, as the current user
#   /usr/bin/salvanza-gui-root     the app as root (machine backups)
#   /usr/lib/salvanza/salvanza-gui
#   /usr/libexec/salvanza/salvanza-svc  the background service
#   /usr/lib/systemd/system/salvanza.service  (enabled on a fresh
#       install, see salvanza.install)
#   /usr/share/applications/salvanza.desktop
#   /usr/share/icons/hicolor/256x256/apps/salvanza.png
#   /usr/share/salvanza/elastio-snap/  the snapshot module installer, with
#                                  the elastio-snap source it builds
#                                  (GPL-2.0-only, hence the second licence)
#
# It replaces the project's earlier packages, proxmoxbackupclient and pbsgo;
# the service adopts /var/lib/proxmoxbackupclient or /var/lib/pbsgo when it
# finds no settings of its own (gui/config_dir_unix.go).
#
# Build host (Arch) requirements: base-devel, go, gtk3, webkit2gtk-4.1
# (Arch ships the cgo headers inside the same packages, no -devel split).
# The GUI frontend is prebuilt and committed under gui/frontend/dist, so
# Node.js is not required.
#
# Source: the package is built from salvanza-<pkgver>.tar.gz in
# THIS directory, produced by `make pkgarch` (packaging/stage-source.sh) from
# the CURRENT working tree - uncommitted changes included - instead of a
# commit fetched from GitHub. pkgver must equal the gui/wails.json
# productVersion of that tree (package() enforces the match).
#
# Build procedure:
#   1. make pkgarch        # stages the tarball, then runs makepkg
#   or, by hand:
#   1. sh packaging/stage-source.sh packaging/arch
#   2. makepkg -f -d
#   The tarball checksum is SKIP on purpose: it is regenerated from the local
#   tree on every build, so there is no fixed sum to pin.

pkgname=salvanza
pkgver=2.0.0
pkgrel=1
pkgdesc='Salvanza, backup for Proxmox Backup Server (app, service and command line)'
arch=(x86_64 aarch64)
url='https://salvanza.org/'
license=(GPL-3.0-or-later GPL-2.0-only)
makedepends=(go gtk3 webkit2gtk-4.1)
# polkit (pkexec): the app asks for an administrator's password through it to
# connect to the service, whose API token is root's alone.
depends=(glibc gtk3 webkit2gtk-4.1 gdk-pixbuf2 glib2 libsoup3 systemd polkit)
optdepends=('sudo: salvanza-gui-root from a terminal'
            'dkms: the snapshot module (the installer adds it, with the kernel headers)')
provides=(proxmoxbackupclient)
conflicts=(proxmoxbackupclient pbsgo)
replaces=(proxmoxbackupclient pbsgo)
install=salvanza.install
options=(!strip)

# Staged from the working tree by packaging/stage-source.sh (see header): the
# tarball must sit next to this PKGBUILD before makepkg starts, which is what
# `make pkgarch` does. SKIP because the sum changes with every staging.
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    # makepkg runs package() with cwd=$srcdir, where the tarball extracts into
    # a subdirectory. Never shadow $srcdir.
    local _srcroot="${pkgname}-${pkgver}"
    local _lin="$_srcroot/packaging/linux"
    if [[ ! -d "$_srcroot" ]]; then
        echo "error: $_srcroot missing in $srcdir - stage the source first:" \
             "sh packaging/stage-source.sh packaging/arch" >&2
        return 1
    fi
    local v
    v=$(sed -n 's/.*"productVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$_srcroot/gui/wails.json")
    if [[ "$v" != "$pkgver" ]]; then
        echo "error: wails.json productVersion ($v) != pkgver ($pkgver);" \
             "update pkgver together with the tree being packaged" >&2
        return 1
    fi

    # go build -o does not create parent directories
    install -d "${pkgdir}/usr/bin" "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/libexec/${pkgname}"

    # --- the command line (workspace mode, go.work from the tarball, as
    #     build-deb.sh); the earlier names are links to it ----------------
    (
        cd "$_srcroot"
        CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${pkgver}" \
            -o "${pkgdir}/usr/bin/salvanza-cli" ./cli
    )
    local old
    for old in proxmoxbackup-directory proxmoxbackup-machine proxmoxbackup-nbd; do
        ln -s salvanza-cli "${pkgdir}/usr/bin/${old}"
    done

    # --- the app (the desktop frontend needs the production build tag;
    #     webkit2_41 selects webkit2gtk-4.1, wails defaults to 4.0) ---------
    local tags=production
    if pkg-config --exists webkit2gtk-4.1; then
        tags="${tags},webkit2_41"
    fi
    (
        cd "$_srcroot/gui"
        go build -trimpath -tags "${tags}" \
            -ldflags "-s -w -X main.appVersion=${pkgver}" \
            -o "${pkgdir}/usr/lib/${pkgname}/salvanza-gui" .
    )

    # --- the background service ---------------------------------------
    (
        cd "$_srcroot/gui"
        CGO_ENABLED=0 go build -trimpath -tags service \
            -ldflags "-s -w -X main.appVersion=${pkgver}" \
            -o "${pkgdir}/usr/libexec/${pkgname}/salvanza-svc" .
    )

    # --- launchers, menu entries, unit, icon, docs ---------------------
    install -Dm 0755 "$_lin/salvanza-gui" "${pkgdir}/usr/bin/salvanza-gui"
    install -Dm 0755 "$_lin/salvanza-gui-root" "${pkgdir}/usr/bin/salvanza-gui-root"
    install -Dm 0644 "$_lin/salvanza.desktop" \
        "${pkgdir}/usr/share/applications/salvanza.desktop"
    install -Dm 0644 "$_lin/salvanza.service" \
        "${pkgdir}/usr/lib/systemd/system/salvanza.service"
    install -Dm 0644 "$_srcroot/gui/Icon.png" \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
    install -Dm 0644 "$_srcroot/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm 0644 "$_srcroot/CHANGELOG.md" "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
    install -d "${pkgdir}/usr/share/doc/${pkgname}/manual"
    install -m 0644 "$_srcroot"/docs/manual/*.md "${pkgdir}/usr/share/doc/${pkgname}/manual/"

    # --- the snapshot module installer and the elastio-snap source it
    #     builds (the app's "Install it for me") --------------------------
    local _snap="${pkgdir}/usr/share/${pkgname}/elastio-snap"
    install -Dm 0755 "$_lin/elastio-snap/install-elastio-snap.sh" "$_snap/install-elastio-snap.sh"
    install -m 0644 "$_lin/elastio-snap/kernel7-strscpy.patch" "$_snap/"
    cp -R "$_lin/elastio-snap/source" "$_snap/source"
    chmod -R u=rwX,go=rX "$_snap/source"
    install -Dm 0644 "$_lin/elastio-snap/source/COPYING" \
        "${pkgdir}/usr/share/licenses/${pkgname}/elastio-snap-COPYING"
}
