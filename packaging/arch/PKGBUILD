# Maintainer: Proxmox Backup Client contributors
#
# proxmoxbackupclient, the same layout as the .deb and .rpm
# (packaging/debian/README.md):
#   /usr/bin/proxmoxbackup-directory   folder backup CLI
#   /usr/bin/proxmoxbackup-machine     whole-disk backup CLI
#   /usr/bin/proxmoxbackup-nbd         attach a disk image as /dev/nbdN (root)
#   /usr/bin/proxmoxbackupclient       the app, as the current user
#   /usr/bin/proxmoxbackupclient-root  the app as root (machine backups)
#   /usr/lib/proxmoxbackupclient/ProxmoxBackupClient
#   /usr/lib/proxmoxbackupclient/ProxmoxBackupClientSVC  the background service
#   /usr/lib/systemd/system/proxmoxbackupclient.service  (enabled on a fresh
#       install, see proxmoxbackupclient.install)
#   /usr/share/applications/proxmoxbackupclient{,-root}.desktop
#   /usr/share/icons/hicolor/256x256/apps/proxmoxbackupclient.png
#
# It replaces the project's earlier pbsgo package; the service adopts
# /var/lib/pbsgo when it finds no settings of its own (gui/config_dir_unix.go).
#
# Build host (Arch) requirements: base-devel, go, gtk3, webkit2gtk-4.1
# (Arch ships the cgo headers inside the same packages, no -devel split).
# The GUI frontend is prebuilt and committed under gui/frontend/dist, so
# Node.js is not required.
#
# Source: the package is built from proxmoxbackupclient-<pkgver>.tar.gz in
# THIS directory, produced by `make pkgarch` (packaging/stage-source.sh) from
# the CURRENT working tree - uncommitted changes included - instead of a
# commit fetched from GitHub. pkgver must equal the gui/wails.json
# productVersion of that tree (package() enforces the match).
#
# Build procedure:
#   1. make pkgarch        # stages the tarball, then runs makepkg
#   or, by hand:
#   1. sh packaging/stage-source.sh packaging/arch
#   2. makepkg -f -d
#   The tarball checksum is SKIP on purpose: it is regenerated from the local
#   tree on every build, so there is no fixed sum to pin.

pkgname=proxmoxbackupclient
pkgver=2.0.0
pkgrel=1
pkgdesc='Backup client for Proxmox Backup Server (app, service and CLIs)'
arch=(x86_64 aarch64)
url='https://github.com/tizbac/proxmoxbackupclient_go'
license=(GPL-3.0-or-later)
makedepends=(go gtk3 webkit2gtk-4.1)
# polkit (pkexec): the app asks for an administrator's password through it to
# connect to the service, whose API token is root's alone.
depends=(glibc gtk3 webkit2gtk-4.1 gdk-pixbuf2 glib2 libsoup3 systemd polkit)
optdepends=('sudo: proxmoxbackupclient-root from a terminal')
conflicts=(pbsgo)
replaces=(pbsgo)
install=proxmoxbackupclient.install
options=(!strip)

# Staged from the working tree by packaging/stage-source.sh (see header): the
# tarball must sit next to this PKGBUILD before makepkg starts, which is what
# `make pkgarch` does. SKIP because the sum changes with every staging.
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    # makepkg runs package() with cwd=$srcdir, where the tarball extracts into
    # a subdirectory. Never shadow $srcdir.
    local _srcroot="${pkgname}-${pkgver}"
    local _lin="$_srcroot/packaging/linux"
    if [[ ! -d "$_srcroot" ]]; then
        echo "error: $_srcroot missing in $srcdir - stage the source first:" \
             "sh packaging/stage-source.sh packaging/arch" >&2
        return 1
    fi
    local v
    v=$(sed -n 's/.*"productVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$_srcroot/gui/wails.json")
    if [[ "$v" != "$pkgver" ]]; then
        echo "error: wails.json productVersion ($v) != pkgver ($pkgver);" \
             "update pkgver together with the tree being packaged" >&2
        return 1
    fi

    # go build -o does not create parent directories
    install -d "${pkgdir}/usr/bin" "${pkgdir}/usr/lib/${pkgname}"

    # --- CLI tools ------------------------------------------------------
    # directorybackup builds module-mode (GOWORK=off): its per-module go.sum
    # is only complete after a `go mod tidy` pass. machinebackup and nbd
    # build in workspace mode (go.work from the tarball), as build-deb.sh.
    (
        cd "$_srcroot/directorybackup"
        GOWORK=off go mod tidy >/dev/null && \
        GOWORK=off CGO_ENABLED=0 go build -trimpath \
            -ldflags "-s -w -X main.version=${pkgver}" \
            -o "${pkgdir}/usr/bin/proxmoxbackup-directory" .
    )
    (
        cd "$_srcroot"
        CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${pkgver}" \
            -o "${pkgdir}/usr/bin/proxmoxbackup-machine" ./machinebackup
        CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${pkgver}" \
            -o "${pkgdir}/usr/bin/proxmoxbackup-nbd" ./nbd
    )

    # --- the app (the desktop frontend needs the production build tag;
    #     webkit2_41 selects webkit2gtk-4.1, wails defaults to 4.0) ---------
    local tags=production
    if pkg-config --exists webkit2gtk-4.1; then
        tags="${tags},webkit2_41"
    fi
    (
        cd "$_srcroot/gui"
        go build -trimpath -tags "${tags}" \
            -ldflags "-s -w -X main.appVersion=${pkgver}" \
            -o "${pkgdir}/usr/lib/${pkgname}/ProxmoxBackupClient" .
    )

    # --- the background service ---------------------------------------
    (
        cd "$_srcroot/gui"
        CGO_ENABLED=0 go build -trimpath -tags service \
            -ldflags "-s -w -X main.appVersion=${pkgver}" \
            -o "${pkgdir}/usr/lib/${pkgname}/ProxmoxBackupClientSVC" .
    )

    # --- launchers, menu entries, unit, icon, docs ---------------------
    install -Dm 0755 "$_lin/proxmoxbackupclient" "${pkgdir}/usr/bin/proxmoxbackupclient"
    install -Dm 0755 "$_lin/proxmoxbackupclient-root" "${pkgdir}/usr/bin/proxmoxbackupclient-root"
    install -Dm 0644 "$_lin/proxmoxbackupclient.desktop" \
        "${pkgdir}/usr/share/applications/proxmoxbackupclient.desktop"
    install -Dm 0644 "$_lin/proxmoxbackupclient-root.desktop" \
        "${pkgdir}/usr/share/applications/proxmoxbackupclient-root.desktop"
    install -Dm 0644 "$_lin/proxmoxbackupclient.service" \
        "${pkgdir}/usr/lib/systemd/system/proxmoxbackupclient.service"
    install -Dm 0644 "$_srcroot/gui/Icon.png" \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
    install -Dm 0644 "$_srcroot/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm 0644 "$_srcroot/CHANGELOG.md" "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
    install -d "${pkgdir}/usr/share/doc/${pkgname}/manual"
    install -m 0644 "$_srcroot"/docs/manual/*.md "${pkgdir}/usr/share/doc/${pkgname}/manual/"
}
