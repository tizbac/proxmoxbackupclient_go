[Unit]
Description=Salvanza for Proxmox Backup Server service (scheduled backups)
Documentation=file:///usr/share/doc/salvanza/manual/GUI.md
Wants=network-online.target
After=network-online.target

# The service keeps /var/lib/salvanza root's alone (0700, files 0600) itself,
# on every start. No StateDirectory=: systemd would create that folder before
# the service starts, and the service then would not take over an earlier
# install's /var/lib/proxmoxbackupclient or /var/lib/pbsgo (it does so only
# while the folder is missing). No sandboxing either: machine backups need
# root's full access to disks and snapshot devices.
#
# The program is in /usr/libexec (all three packages): on Fedora, SELinux
# then runs it as unconfined_service_t, as any service without a policy of
# its own, rather than in systemd's own domain.
[Service]
Type=simple
ExecStart=/usr/libexec/salvanza/salvanza-svc
Restart=on-failure
RestartSec=60
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
