#!/bin/sh
# salvanza-gui: start Salvanza for Proxmox Backup Server as the current user.
# Folder backups of the user's own files work this way; machine (whole-disk)
# backups and snapshots need root: use salvanza-gui-root for those.
#
# With -list-sets, -undelete or -rollback it runs those on the command line
# instead (see the CLI manual), without a window.
exec /usr/lib/salvanza/salvanza-gui "$@"
