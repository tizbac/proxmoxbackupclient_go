#!/bin/sh
# preinst: runs before package installation
set -e

# Stop the service on upgrade to avoid conflicts. Deliberately NOT
# disabling it: the user's enablement must survive an upgrade (fresh
# installs never enable anything either - see postinst).
if [ "$1" = "upgrade" ]; then
    if systemctl is-active --quiet pbsgo 2>/dev/null; then
        systemctl stop pbsgo 2>/dev/null || true
    fi
fi

exit 0