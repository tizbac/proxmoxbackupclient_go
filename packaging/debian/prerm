#!/bin/sh
# prerm: runs before package removal
set -e

# Stop and disable the service
if systemctl is-active --quiet pbsgo 2>/dev/null; then
    systemctl stop pbsgo 2>/dev/null || true
fi
if systemctl is-enabled --quiet pbsgo 2>/dev/null; then
    systemctl disable pbsgo 2>/dev/null || true
fi

exit 0