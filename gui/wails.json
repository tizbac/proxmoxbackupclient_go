{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "salvanza-gui",
  "outputfilename": "salvanza-gui",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev": "npm run dev",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Salvanza contributors",
    "email": ""
  },
  "info": {
    "companyName": "Salvanza",
    "productName": "Salvanza for Proxmox Backup Server",
    "productVersion": "2.1.0",
    "copyright": "© 2024-2026 Salvanza contributors and RDEM Systems.",
    "comments": "Backup client for Proxmox Backup Server"
  },
  "webview2": {
    "installmethod": "download"
  },
  "windows": {
    "hideConsole": false,
    "manifest": {
      "level": "asInvoker",
      "uiAccess": false
    },
    "icon": "build/windows/icon.ico"
  }
}
