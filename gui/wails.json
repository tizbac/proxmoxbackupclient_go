{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "ProxmoxBackupClient",
  "outputfilename": "ProxmoxBackupClient",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev": "npm run dev",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Proxmox Backup Client contributors",
    "email": ""
  },
  "info": {
    "companyName": "Proxmox Backup Client",
    "productName": "Proxmox Backup Client",
    "productVersion": "0.2.119",
    "copyright": "© 2024-2026 RDEM Systems and Proxmox Backup Client GO Contributors.",
    "comments": "Backup client for Proxmox Backup Server"
  },
  "webview2": {
    "installmethod": "download"
  },
  "windows": {
    "hideConsole": false,
    "manifest": {
      "level": "requireAdministrator",
      "uiAccess": false
    },
    "icon": "build/windows/icon.ico"
  }
}
