<?xml version="1.0" encoding="UTF-8"?>
<!-- ===================================================================== -->
<!-- Default brand installer entry: Salvanza for Proxmox Backup Server.     -->
<!--                                                                         -->
<!-- This is a BRAND ENTRY file: it only supplies the brand identity via     -->
<!-- define and pulls in the shared body (ProductBody.wxi). Another brand    -->
<!-- copies it to <Brand>.wxs with its own defines. The programs are         -->
<!-- installed as ExeName and ServiceExeName (<FileBase>-gui, -svc); the     -->
<!-- app finds its brand from that name at runtime (gui/brand.go), so the    -->
<!-- names here and the brand's FileBase and Folder there must match.        -->
<!-- ===================================================================== -->
<?define ProductName = "Salvanza for Proxmox Backup Server" ?>
<?define ExeName = "salvanza-gui" ?>
<?define ServiceExeName = "salvanza-svc" ?>
<!-- The brand's folder name: Program Files\<it>, C:\ProgramData\<it>. -->
<?define Folder = "Salvanza" ?>
<?define VendorKey = "Salvanza" ?>
<?define Manufacturer = "Salvanza" ?>
<?define UpgradeCode = "2EAC4C12-3459-4D47-8B53-489A96ACCFE8" ?>
<?define ArpUrlAbout = "https://salvanza.org/" ?>
<?define ArpHelpLink = "https://github.com/salvanza/salvanza_client" ?>
<?define ArpUrlUpdateInfo = "https://github.com/salvanza/salvanza_client/releases" ?>
<?define ArpContact = "https://github.com/salvanza/salvanza_client/issues" ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- ProductVersion is passed from CI via candle -dProductVersion=x.y.z;
       this is the local-dev fallback. Keep in sync with gui/wails.json. -->
  <?ifndef ProductVersion ?>
    <?define ProductVersion = "2.1.0" ?>
  <?endif ?>

  <?include ProductBody.wxi ?>
</Wix>
