<?xml version="1.0" encoding="UTF-8"?>
<!-- ===================================================================== -->
<!-- Default brand installer entry ("Proxmox Backup Client").               -->
<!--                                                                         -->
<!-- This is a BRAND ENTRY file: it only supplies the brand identity via     -->
<!-- !define and pulls in the shared body (ProductBody.wxi). To ship a       -->
<!-- different vendor's build, copy this file to <Brand>.wxs, edit the       -->
<!-- defines (the exe is installed under ExeName, which must equal the        -->
<!-- installer/output filename), and light it to <Brand>.msi. The GUI        -->
<!-- picks up the matching brand at runtime from gui/brand.go (brandCatalog)  -->
<!-- — the installed exe name IS the brand key.                               -->
<!-- Keep the GUI-side list (colors/logo/URLs) and these defines in sync.    -->
<!-- ===================================================================== -->
<?define ProductName = "Proxmox Backup Client" ?>
<?define ExeName = "ProxmoxBackupClient" ?>
<?define ServiceExeName = "ProxmoxBackupClientSVC" ?>
<?define VendorKey = "Proxmox Backup Client" ?>
<?define Manufacturer = "Proxmox Backup Client" ?>
<!-- Fixed for this product line: every version upgrades the one before.
     Never change it, or an upgrade installs beside the old version. -->
<?define UpgradeCode = "F15C307F-1053-46B7-BCB0-2FAAC3627ED6" ?>
<?define ArpUrlAbout = "https://github.com/mjb-is/proxmoxbackupclient_go" ?>
<?define ArpHelpLink = "https://github.com/mjb-is/proxmoxbackupclient_go/tree/master/docs/manual" ?>
<?define ArpUrlUpdateInfo = "https://github.com/mjb-is/proxmoxbackupclient_go/releases" ?>
<?define ArpContact = "https://github.com/mjb-is/proxmoxbackupclient_go/issues" ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- ProductVersion comes from build-msi.ps1 (candle -dProductVersion=x.y.z,
       read from gui/wails.json); this is only a fallback. -->
  <?ifndef ProductVersion ?>
    <?define ProductVersion = "0.0.1" ?>
  <?endif ?>

  <?include ProductBody.wxi ?>
</Wix>
