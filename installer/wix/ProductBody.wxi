<!-- Shared installer body. Included by a brand entry file (see Product.wxs /
     NimbusBackup.wxs / AcmeBackup.wxs) that supplies the brand identity via
     !define BEFORE the include. All identity is driven by $(var.*):
       ProductName, ExeName, ServiceExeName, VendorKey, Manufacturer,
       UpgradeCode, ProductVersion, ArpUrlAbout, ArpHelpLink,
       ArpUrlUpdateInfo, ArpContact.
     The exe is installed under the SAME name as the installer (ExeName); the
     GUI resolves its brand from the exe base name at runtime (gui/brand.go),
     so the installed exe name == installer name == brand key. -->
<Include>
  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="$(var.ProductName) - Proxmox Backup Server Client"
             Comments="Backup client with automatic scheduling and VSS support" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      Schedule="afterInstallInitialize"
      AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Application icon, selected from installer/icons/ by the ExeName -->
    <Icon Id="AppIcon" SourceFile="../icons/$(var.ExeName).ico" />
    <!-- The icon Programs and Features shows -->
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Installation directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ExeName)" />
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)"/>
      </Directory>
    </Directory>

    <!-- Main application files -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- GUI Executable (installed under the installer/ExeName) -->
      <Component Id="GUIExecutable" Guid="*" Win64="yes">
        <File Id="GuiExe"
              Source="../../gui/build/bin/$(var.ExeName).exe"
              KeyPath="yes" />
      </Component>

      <!-- Service Executable (shares the ExeName base with a "SVC" suffix) -->
      <Component Id="ServiceExecutable" Guid="*" Win64="yes">
        <File Id="SvcExe"
              Source="../../gui/build/bin/$(var.ServiceExeName).exe"
              KeyPath="yes" />

        <!-- Service installation -->
        <ServiceInstall
          Id="BackupService"
          Type="ownProcess"
          Name="$(var.ServiceExeName)"
          DisplayName="$(var.ProductName) Service"
          Description="Executes scheduled backups to Proxmox Backup Server with VSS support"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Interactive="no">
          <ServiceDependency Id="RPCSS"/>
        </ServiceInstall>

        <ServiceControl
          Id="ControlBackupService"
          Name="$(var.ServiceExeName)"
          Start="install"
          Stop="both"
          Wait="yes"
          Remove="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="Backup client for Proxmox Backup Server"
                  Icon="AppIcon"
                  Target="[INSTALLFOLDER]$(var.ExeName).exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.VendorKey)\$(var.ExeName)"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>

      <!-- Auto-start registry entry (conditional) -->
      <Component Id="AutoStartRegistry" Guid="*">
        <Condition>AUTOSTART = "1"</Condition>
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="$(var.ExeName)"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]$(var.ExeName).exe&quot; --minimized"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Features -->
    <Feature Id="ProductFeature"
             Title="$(var.ProductName)"
             Level="1"
             Description="Complete backup solution with automatic scheduling">
      <ComponentRef Id="GUIExecutable" />
      <ComponentRef Id="ServiceExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="AutoStartRegistry" />
    </Feature>

    <!-- Add/Remove Programs metadata (Programs & Features). Per-brand; keep in
         sync with the brand's Urls map in gui/brand.go. -->
    <Property Id="ARPURLINFOABOUT" Value="$(var.ArpUrlAbout)" />
    <Property Id="ARPHELPLINK" Value="$(var.ArpHelpLink)" />
    <Property Id="ARPURLUPDATEINFO" Value="$(var.ArpUrlUpdateInfo)" />
    <Property Id="ARPCONTACT" Value="$(var.ArpContact)" />

    <!-- UI: WixUI_InstallDir's dialogs (copied below as WixUI_PbcInstallDir),
         with the keep-settings page between Remove and Ready to remove, and
         without WixUI_InstallDir's ARPNOMODIFY: Programs and Features' plain
         "Uninstall" runs without any pages, so "Change" (Settings: "Modify")
         must stay to reach Remove and that question. -->
    <UIRef Id="WixUI_PbcInstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- License -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ==================== AUTO-START CONFIGURATION ==================== -->
    <Property Id="AUTOSTART" Value="1" />

    <!-- ==================== UNINSTALL CONFIGURATION CLEANUP ==================== -->
    <!-- Secure: the choice made on the uninstall page must reach the
         elevated part of the removal. -->
    <Property Id="KEEP_CONFIG" Value="1" Secure="yes" />

    <CustomAction Id="SetKeepConfigNo" Property="KEEP_CONFIG" Value="0" />
    <CustomAction Id="SetKeepConfigYes" Property="KEEP_CONFIG" Value="1" />

    <!-- Custom action to kill all GUI processes before upgrade -->
    <CustomAction Id="KillGUIProcesses"
                  Directory="TARGETDIR"
                  ExeCommand='cmd.exe /c "taskkill /F /IM $(var.ExeName).exe /T 2&gt;nul || exit 0"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Custom action to delete config directory. Every brand keeps its
         settings in C:\ProgramData\ProxmoxBackupClient (gui/config.go
         getConfigDir), whatever its ExeName. -->
    <CustomAction Id="DeleteConfigFolder"
                  Directory="TARGETDIR"
                  ExeCommand='cmd.exe /c "if exist "%ProgramData%\ProxmoxBackupClient" rmdir /s /q "%ProgramData%\ProxmoxBackupClient""'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- The maintenance pages disable their Change button when ARPNOMODIFY is
         set, so set it for the pages only, and clear it again before the
         product is registered so Programs and Features keeps "Change". -->
    <CustomAction Id="SetNoModifyForPages" Property="ARPNOMODIFY" Value="1" />
    <CustomAction Id="ClearNoModify" Property="ARPNOMODIFY" Value="[PBC_NOTHING]" />
    <InstallUISequence>
      <Custom Action="SetNoModifyForPages" Before="MaintenanceWelcomeDlg">Installed</Custom>
    </InstallUISequence>

    <!-- Schedule custom actions -->
    <InstallExecuteSequence>
      <Custom Action="ClearNoModify" Before="RegisterProduct">ARPNOMODIFY</Custom>
      <Custom Action="KillGUIProcesses" Before="StopServices">
        UPGRADINGPRODUCTCODE
      </Custom>
      <Custom Action="DeleteConfigFolder" Before="RemoveFiles">
        (REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE AND (KEEP_CONFIG="0")
      </Custom>
    </InstallExecuteSequence>

    <!-- Custom dialogs (WiX UI extension) -->
    <UI>
      <Dialog Id="UninstallDlg" Width="370" Height="270" Title="[ProductName] - Uninstall">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Uninstall [ProductName]</Text>
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>Do you want to keep your configuration and logs?</Text>
        </Control>

        <Control Id="ConfigInfo" Type="Text" X="25" Y="60" Width="320" Height="60" Transparent="yes" NoPrefix="yes">
          <Text>The settings are kept in C:\ProgramData\ProxmoxBackupClient: the PBS servers and their tokens, the Backup Sets, encryption keys, reports and logs. Keep them to reinstall later with everything as it was.</Text>
        </Control>

        <Control Id="KeepConfigRadio" Type="RadioButtonGroup" X="25" Y="130" Width="320" Height="50" Property="KEEP_CONFIG">
          <RadioButtonGroup Property="KEEP_CONFIG">
            <RadioButton Text="Keep configuration" Value="1" X="0" Y="0" Width="300" Height="15" />
            <RadioButton Text="Delete configuration" Value="0" X="0" Y="20" Width="300" Height="15" />
          </RadioButtonGroup>
        </Control>

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
        </Control>

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>

        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>

    <!-- WixUI_InstallDir (WiX 3.14) as it is, except: Remove goes through
         UninstallDlg, and no ARPNOMODIFY property (see SetNoModifyForPages). -->
    <UI Id="WixUI_PbcInstallDir">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">LicenseAccepted = "1"</Publish>

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2"><![CDATA[Installed AND NOT PATCH AND WixUI_InstallMode<>"Remove"]]></Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="UninstallDlg" Order="2">Installed AND NOT PATCH AND WixUI_InstallMode="Remove"</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">Installed AND PATCH</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="UninstallDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
    </UI>
    <UIRef Id="WixUI_Common" />

  </Product>
</Include>
